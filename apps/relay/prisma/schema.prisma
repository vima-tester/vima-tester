// Prisma schema for the vima-tester relay.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  agents       Agent[]
  pairingCodes PairingCode[]
  collections  Collection[]
  environments Environment[]
}

/// A paired vima-tunneler instance. `tokenHash` is a SHA-256 of the token;
/// the plaintext token is shown to the agent exactly once, at pairing.
model Agent {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String?
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}

/// Single-use, short-lived code exchanged for an agent token.
model PairingCode {
  code      String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Collection {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime         @default(now())
  items     CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String     @id @default(uuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  name         String
  method       String     @default("GET")
  url          String
  headers      Json       @default("{}")
  body         String?
  position     Int        @default(0)

  @@index([collectionId])
}

model Environment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  variables Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId])
}
