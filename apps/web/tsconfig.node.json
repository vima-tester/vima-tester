{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    // The protocol workspace pulls Vite 5 in via Vitest 2, so the hoisted
    // `@vitejs/plugin-react` would otherwise type against Vite 5 while this
    // app runs Vite 6. Pin the types to our own copy.
    "paths": {
      "vite": ["./node_modules/vite/dist/node/index.d.ts"],
      "vite/*": ["./node_modules/vite/*"]
    }
  },
  "include": ["vite.config.ts"]
}
