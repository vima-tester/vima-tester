# Relay (apps/relay). Copy to apps/relay/.env and adjust.
# Any reachable PostgreSQL 16 instance; the relay connects on boot.
DATABASE_URL="postgresql://vima:vima@localhost:5432/vima_tester?schema=public"

PORT=3001
CORS_ORIGIN="http://localhost:5173"
PAIRING_CODE_TTL_SECONDS=600

# Firebase Admin service-account credentials (used to verify browser ID tokens).
# Project Settings -> Service accounts -> Generate new private key. The private
# key is a single line with "\n" escapes; keep the surrounding quotes.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Web (apps/web). Copy to apps/web/.env.local. Public Firebase web config
# (Project Settings -> General -> Your apps -> SDK setup and configuration).
VITE_FIREBASE_API_KEY="your-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"
