# Relay (apps/relay). Copy to apps/relay/.env and adjust.
# Matches docker-compose.yml (host port 5434).
DATABASE_URL="postgresql://vima:vima@localhost:5434/vima_tester?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=3001
CORS_ORIGIN="http://localhost:5173"
PAIRING_CODE_TTL_SECONDS=600

# Web (apps/web). Copy to apps/web/.env.local.
VITE_API_URL="http://localhost:3001"
